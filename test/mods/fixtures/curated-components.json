{
  "token-weather": {
    "records": [
      "d 4096 .claude-plugin",
      "f 0 .claude-plugin/plugin.json",
      "f 0 .gitignore",
      "f 0 README.md",
      "d 4096 hooks",
      "f 49 hooks/hooks.json",
      "f 0 hooks/token-weather.mjs",
      "d 4096 screenshots",
      "f 0 screenshots/token-weather-clear.png",
      "f 0 screenshots/token-weather-showers.png",
      "f 0 screenshots/token-weather-storm.png"
    ],
    "pluginJson": {
      "name": "token-weather",
      "version": "0.1.0",
      "description": "A live forecast of the context window, drawn above the prompt: a weather icon, the fill percentage, and a chart of the last turns.",
      "author": {
        "name": "Claude Code DevRel"
      }
    },
    "hooksJson": "{\n  \"modules\": [\n    \"./token-weather.mjs\"\n  ]\n}\n",
    "modules": ["./token-weather.mjs"]
  },
