# The env schema (varlock, https://varlock.dev): every variable the app reads, its type, whether it's
# secret, and where each environment sets it. Committed; it holds no values that differ per env.
#
# Files layered on top of it:
#   .env.development — committed local-dev defaults that aren't secret (local Postgres, dev origin).
#   .env.local       — gitignored. Your own dev secrets (README §2). Bun auto-loads both dev files,
#                      and .env.local wins.
#   .env.staging     — gitignored. Staging values, pushed to Fly with `bun run secrets:push staging`.
#   .env.production  — gitignored. Production values, pushed with `bun run secrets:push production`.
# Staging and production secrets are encrypted (`APP_ENV=staging bunx varlock encrypt --file
# .env.staging`, likewise production): the key lives in your Mac's Secure Enclave, so decrypting asks
# for Touch ID, and secrets:push refuses a plaintext one. Run a script against one of those envs with
# `bun run with-env <env> <script.ts>`. A server never reads these files. Items tagged `fly` are the
# Fly secrets secrets:push manages.
#
# Items are secret unless marked @public. Check your config with `bunx varlock load` (secrets
# redacted), or `bunx varlock load --agent` for redacted JSON. `bun run check:env` (in the gate) fails
# when code reads an env var this file doesn't declare, or a declared one is no longer read.
#
# @currentEnv=$APP_ENV @defaultRequired=false
# The repo reads required config through these helpers, which varlock audit doesn't know.
# @auditExtraPatterns(regex('(?:requireEnv|requireStrongSecret|isFlagEnabled)\(\s*\'([A-Z0-9_]+)\'\)'))
# Set per command or by the runtime, never in an env file: runtime flags, test switches, and the knobs
# of the smoke, load-test and profiling scripts.
# @auditIgnoreKeys(NODE_ENV, DEV, VITEST, RUN_E2B, CLAUDE_CODE_OAUTH_TOKEN, SMOKE_*, PROFILE_*, FLY_API_TOKEN, FLY_APP, FLY_ORG, SHA)
# Sample status line scripts, not app code.
# @auditIgnorePaths(./scripts/seed-data)
# ---

# Which env file varlock layers on this schema: development (the default) layers .env.development and
# .env.local; secrets:push and with-env set staging or production. The app never reads it.
# @type=enum(development, staging, production) @public
APP_ENV=development

# Postgres connection URL. Local dev uses the Docker Postgres from README §1 (set in .env.development),
# which has no TLS, so no sslmode. Staging and production use the env's pooled Neon URL and MUST add
# `sslmode=require` (or verify-ca / verify-full): the app refuses to boot on a plaintext production
# connection (src/db/assert-tls.ts).
# @required @sensitive=forEnv(staging, production) @tag(fly) @type=url(allowedProtocols=[postgres, postgresql])
DATABASE_URL=

# The env's public origin (local dev's is in .env.development). The dev server's port and the auth
# origins derive from it.
# @required @public @tag(fly) @type=url
BETTER_AUTH_URL=

# Signs session cookies. A distinct random value per env: `openssl rand -base64 32`. The app refuses
# anything shorter than 32 characters (src/lib/env.ts).
# @required @tag(fly) @type=string(minLength=32)
BETTER_AUTH_SECRET=

# The env's GitHub OAuth app: README §2 for dev, docs/deploy.md for staging and production.
# @required @public @tag(fly) @type=string
GITHUB_CLIENT_ID=
# @required @tag(fly) @type=string
GITHUB_CLIENT_SECRET=

# The web server calls GitHub when a user submits a mod and when an admin approves one; without a
# token those calls share GitHub's anonymous limit of 60 requests an hour. Optional locally, where it
# also serves the operator mod scripts. Use a fine-grained token with public-repository read access
# only, never one that can read private repositories.
# @required=forEnv(staging, production) @tag(fly) @type=string
GITHUB_TOKEN=

# One E2B account serves every env. Optional locally: set RENDER_RUNNER=fake instead.
# @required=forEnv(staging, production) @tag(fly) @type=string
E2B_API_KEY=

# Local only: `fake` renders submissions without E2B. Leave it unset on staging and production, which
# refuse it (NODE_ENV=production).
# @public @type=enum(fake)
RENDER_RUNNER=

# Server-only key for emailing submission review decisions. A separate key per env.
# @required=forEnv(staging, production) @tag(fly) @type=string
RESEND_API_KEY=

# `true` adds `X-Robots-Tag: noindex, nofollow` to every response. Staging only, and set in
# fly.staging.toml [env] since it isn't a secret; never production. Off when unset or any other value.
# Read through a constant (src/server/noindex.ts), which varlock audit can't follow.
# @public @auditIgnore
NOINDEX_SITE=

# PostHog analytics: set ONLY in .env.production. Read on the server at runtime and handed to the
# page, so leaving it unset keeps analytics off in local dev and staging (one shared project). The
# project token is a public, write-only key.
# @required=forEnv(production) @public @tag(fly) @type=string
POSTHOG_PROJECT_TOKEN=
# Optional. When unset, the server uses https://us.i.posthog.com.
# @public @tag(fly) @type=url
POSTHOG_HOST=

# Load testing only, and optional: leave unset. scripts/loadtest/capture.ts derives the unpooled URL
# from DATABASE_URL by stripping `-pooler` from the host (so pg_stat_activity reads the real backends,
# not the pooler's view). Set this only to override that on a non-Neon host.
# @sensitive=forEnv(staging, production) @type=url(allowedProtocols=[postgres, postgresql])
DIRECT_DATABASE_URL=
