{
  "name": "statuslines",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun run .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "format:unsafe": "biome check --write --unsafe .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:e2b": "RUN_E2B=1 bun --bun vitest run test/render/e2b.integration.test.ts test/render/e2b-network.integration.test.ts",
    "check": "bun run format && bun run check:ci",
    "check:ci": "bun run typecheck && bun run lint && bun run check:frontend && bun run check:boundaries && bun run check:deps && bun run check:env && bun --bun run test",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "check:boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "check:frontend": "bun run scripts/check-frontend.ts",
    "check:deps": "bun run scripts/check-dependencies.ts",
    "check:env": "varlock audit",
    "smoke": "bun run scripts/smoke.ts",
    "smoke:desktop": "bun run scripts/smoke-desktop.ts",
    "e2e:rejection-resubmission": "bun run scripts/e2e/rejection-resubmission.ts",
    "deploy:staging": "bun run scripts/deploy-staging.ts",
    "deploy:prod": "bun run scripts/deploy-prod.ts",
    "secrets:push": "bun --no-env-file scripts/push-secrets.ts",
    "with-env": "bun --no-env-file scripts/with-deploy-env.ts",
    "render": "bun run scripts/render.ts",
    "rerender:previews": "bun run scripts/rerender-previews.ts",
    "render:mods": "bun run scripts/render-mods.ts",
    "build:e2b-template": "bun run scripts/build-e2b-template.ts",
    "build:e2b-mod-template": "bun run scripts/build-e2b-mod-template.ts",
    "build:e2b-desktop-template": "bun run scripts/build-e2b-desktop-template.ts",
    "build:font": "bun run scripts/build-font-subset.ts",
    "seed:gallery": "bun run scripts/seed-gallery.ts",
    "seed:community": "bun run scripts/run-seed-community.ts",
    "generate:content": "bun run scripts/generate-content.ts",
    "import:mods": "bun run scripts/import-mods.ts",
    "input-steps:mods": "bun run scripts/input-steps.ts",
    "profile:bench": "bun run scripts/profiling/bench-phases.ts",
    "profile:memory": "PROFILE_MEMORY_HOST=127.0.0.1 bun run scripts/profiling/memory-loop.ts",
    "profile:server": "bun run scripts/profiling/profile-server.ts",
    "dev:login": "bun run scripts/dev-login.ts",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "[ ! -f .env.schema ] || bunx varlock scan --staged && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.7",
    "@number-flow/react": "0.6.2",
    "@posthog/react": "1.11.3",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "anser": "2.3.5",
    "better-auth": "1.7.7",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "diff": "9.0.0",
    "drizzle-orm": "0.45.4",
    "e2b": "2.55.0",
    "lucide-react": "1.55.0",
    "postgres": "3.4.9",
    "posthog-js": "1.438.7",
    "posthog-node": "5.55.1",
    "radix-ui": "1.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.32.1",
    "satori": "0.26.0",
    "shiki": "4.5.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tldts": "7.4.18",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@electric-sql/pglite": "0.5.8",
    "@swc/core": "1.16.13",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "@xterm/headless": "6.0.0",
    "dependency-cruiser": "18.5.0",
    "drizzle-kit": "0.31.11",
    "jsdom": "29.1.1",
    "nitro": "3.0.260522-beta",
    "simple-git-hooks": "2.14.0",
    "typescript": "7.0.2",
    "varlock": "1.23.0",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "vitest-axe": "0.1.0"
  }
}
