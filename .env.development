# Local-dev defaults: committed, and never secret. Bun auto-loads this file in dev, with .env.local
# winning over it, and varlock layers it on .env.schema when APP_ENV is development (the default).
# Put your own secrets in .env.local (README §2).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/statuslines
BETTER_AUTH_URL=http://localhost:3100
